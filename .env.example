# ==========================================
# Agendamento (Cron + Jitter)
# ==========================================
# Expressão cron padrão (ex: a cada 15 minutos)
CRON_SCHEDULE="*/15 * * * *"
# Executar um ciclo imediatamente ao iniciar o bot (true/false)
RUN_ON_STARTUP=false
# Jitter aleatório antes de iniciar a coleta (em segundos)
JITTER_MIN_SECONDS=5
JITTER_MAX_SECONDS=25

# ==========================================
# Coleta (Mercado Livre + Playwright)
# ==========================================
# URLs separadas por vírgula para varredura
ML_OFFER_URLS="https://www.mercadolivre.com.br/ofertas"
# Quantidade máxima de páginas por URL em cada ciclo
ML_MAX_PAGES_PER_URL=2
# Rodar navegador sem interface gráfica (true em produção, false para debug)
PLAYWRIGHT_HEADLESS=true
# Timeout de navegação em ms
PLAYWRIGHT_TIMEOUT_MS=30000

# ==========================================
# Filtragem e Deduplicação (SQLite)
# ==========================================
# Percentual mínimo de desconto para aprovar uma oferta
MIN_DISCOUNT_PERCENT=20
# Janela de deduplicação em horas (24 ou 48)
DEDUP_WINDOW_HOURS=24
# Caminho do arquivo SQLite
SQLITE_DB_PATH="./data/offers.sqlite"

# ==========================================
# Conversão para Link de Afiliado
# ==========================================
# Modos suportados:
# - "shortener_api": chama um endpoint configurável para gerar links curtos (ex: https://meli.la/...)
# - "params": injeta os parâmetros matt_word / matt_tool diretamente na URL limpa
# - "none": mantém a URL limpa (apenas para testes locais)
AFFILIATE_MODE="shortener_api"

# Usado quando AFFILIATE_MODE="shortener_api" (ou fallback)
# Exemplo de endpoint próprio / serviço de encurtamento de afiliado
AFFILIATE_SHORTENER_URL=""
AFFILIATE_SHORTENER_TOKEN=""
# Se true, caso o encurtador falhe ou não esteja configurado, usa modo "params"
AFFILIATE_FALLBACK_TO_PARAMS=true

# Usado quando AFFILIATE_MODE="params" (ou fallback)
ML_MATT_WORD=""
ML_MATT_TOOL=""

# ==========================================
# Fila de Disparo (BullMQ + Redis)
# ==========================================
REDIS_URL="redis://127.0.0.1:6379"
# Delay aleatório entre envios (15 a 45 segundos)
SEND_DELAY_MIN_MS=15000
SEND_DELAY_MAX_MS=45000

# ==========================================
# WhatsApp (Baileys)
# ==========================================
# Pasta onde a sessão autenticada do WhatsApp será salva
WA_AUTH_DIR="./auth_info_baileys"
# IDs dos grupos de destino separados por vírgula (ex: 120363000000000000@g.us)
# Use "npm run groups" após escanear o QR Code para descobrir os IDs
WA_TARGET_GROUPS=""

# ==========================================
# Logs
# ==========================================
LOG_LEVEL="info"
