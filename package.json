{
  "name": "bot-ofertas",
  "version": "1.0.0",
  "description": "Bot de ofertas do Mercado Livre com Playwright, SQLite, BullMQ e WhatsApp (Baileys)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "groups": "tsx src/scripts/list-groups.ts",
    "run:once": "tsx src/scripts/run-once.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "latest",
    "better-sqlite3": "^12.4.1",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0",
    "playwright": "^1.56.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
